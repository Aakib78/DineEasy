# Where the print agent's own services/api server is reachable on the restaurant LAN.
# Same-machine deployment (see README.md) means this is usually localhost; a separate print
# station on the LAN would point this at the server's LAN IP instead.
PRINT_AGENT_API_BASE_URL=http://localhost:3000

# A staff login for a service account created specifically for this agent — see README.md for
# why it should hold only the "printers.manage" permission and be scoped to exactly one outlet
# (an org-wide account would need to be told which outlet to act on; this agent never asks).
PRINT_AGENT_EMAIL=printer-agent@yourrestaurant.example
PRINT_AGENT_PASSWORD=change-me

# Optional. How often (ms) each configured NETWORK printer is polled for its next queued job.
# Default: 5000 (5s) — frequent enough that a KOT reaches the kitchen printer promptly without
# hammering the API.
PRINT_AGENT_POLL_INTERVAL_MS=5000

# Optional. How long (ms) to wait for a printer to accept a ticket before giving up and
# reporting the job FAILED (the backend then re-queues it automatically, up to 3 attempts —
# see docs/printing.md). Default: 5000.
PRINT_AGENT_JOB_TIMEOUT_MS=5000

# Optional. A free-text label for this agent's login session, visible to staff/admins as
# "device info" on that session. Defaults to "print-agent@<hostname>" if omitted.
PRINT_AGENT_DEVICE_INFO=Kitchen-PC-1
