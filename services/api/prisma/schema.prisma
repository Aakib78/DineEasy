// DineEasy — Prisma schema
// Conventions:
//  - Every tenant-scoped model carries organizationId (and outletId where applicable).
//    Application code MUST filter by these via TenantContext — see docs/architecture.md §3.
//  - All money fields are Decimal (Postgres NUMERIC), never Float.
//  - IDs are UUID v4 strings generated by the application/Prisma, not auto-increment ints,
//    so IDs are never guessable and are safe to expose (e.g. QR tokens reference tables by
//    opaque signed token, never raw IDs, per docs/architecture.md).
//  - `*Snapshot` fields freeze a name/price at the moment of the transaction so historical
//    orders/invoices remain correct even if the menu changes later.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// Identity & tenancy
// =============================================================================

model Organization {
  id           String   @id @default(uuid())
  name         String
  legalName    String?
  gstin        String?
  phone        String?
  email        String?
  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  pincode      String?
  country      String   @default("IN")
  currency     String   @default("INR")
  locale       String   @default("en-IN")
  timezone     String   @default("Asia/Kolkata")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  outlets    Outlet[]
  users      User[]
  roles      Role[]
  auditLogs  AuditLog[]

  @@map("organizations")
}

model Outlet {
  id                  String   @id @default(uuid())
  organizationId      String
  name                String
  code                String
  phone               String?
  addressLine1        String?
  addressLine2        String?
  city                String?
  state                String?
  pincode              String?
  gstin                String?
  fssaiLicense         String?
  timezone             String   @default("Asia/Kolkata")
  serviceChargePercent Decimal  @default(0) @db.Decimal(5, 2)
  roundOffEnabled      Boolean  @default(true)
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userRoles       UserRole[]
  floors          Floor[]
  tables          RestaurantTable[]
  menus           Menu[]
  modifierGroups  ModifierGroup[]
  taxGroups       TaxGroup[]
  orders          Order[]
  kitchenStations KitchenStation[]
  printers        Printer[]
  diningSessions  DiningSession[]
  dailyCounters   OutletDailyCounter[]
  auditLogs       AuditLog[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("outlets")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model User {
  id           String     @id @default(uuid())
  organizationId String
  name         String
  email        String
  phone        String?
  passwordHash String
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  roles         UserRole[]
  refreshTokens RefreshToken[]
  orderEvents   OrderEvent[]
  auditLogs     AuditLog[]

  @@unique([organizationId, email])
  @@index([organizationId])
  @@map("users")
}

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  deviceInfo String?
  ipAddress  String?
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Role {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  isSystem       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions  RolePermission[]
  userRoles    UserRole[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("roles")
}

model Permission {
  id          String @id @default(uuid())
  key         String @unique
  description String

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

/// A user's role assignment. outletId = null means the role applies across all outlets
/// in the organization (typically the Owner role).
model UserRole {
  id        String   @id @default(uuid())
  userId    String
  roleId    String
  outletId  String?
  createdAt DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  outlet Outlet? @relation(fields: [outletId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, outletId])
  @@index([userId])
  @@index([outletId])
  @@map("user_roles")
}

// =============================================================================
// Floors, tables, QR
// =============================================================================

model Floor {
  id           String   @id @default(uuid())
  outletId     String
  name         String
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  outlet Outlet            @relation(fields: [outletId], references: [id], onDelete: Cascade)
  tables RestaurantTable[]

  @@unique([outletId, name])
  @@index([outletId])
  @@map("floors")
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  DISABLED
}

/// Named RestaurantTable (not Table) to avoid ambiguity with the SQL keyword and stay
/// readable in generated Prisma Client code (`prisma.restaurantTable`).
model RestaurantTable {
  id           String      @id @default(uuid())
  outletId     String
  floorId      String
  name         String
  capacity     Int         @default(2)
  status       TableStatus @default(AVAILABLE)
  displayOrder Int         @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  outlet         Outlet          @relation(fields: [outletId], references: [id], onDelete: Cascade)
  floor          Floor           @relation(fields: [floorId], references: [id], onDelete: Cascade)
  qrCode         TableQrCode?
  diningSessions DiningSession[]
  orders         Order[]

  @@unique([floorId, name])
  @@index([outletId])
  @@map("tables")
}

model TableQrCode {
  id             String    @id @default(uuid())
  tableId        String    @unique
  token          String    @unique
  isActive       Boolean   @default(true)
  regeneratedAt  DateTime?
  createdAt      DateTime  @default(now())

  table RestaurantTable @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@index([token])
  @@map("table_qr_codes")
}

enum DiningSessionStatus {
  OPEN
  CLOSED
}

model DiningSession {
  id             String              @id @default(uuid())
  organizationId String
  outletId       String
  tableId        String
  status         DiningSessionStatus @default(OPEN)
  startedAt      DateTime            @default(now())
  endedAt        DateTime?
  metadata       Json?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  outlet Outlet          @relation(fields: [outletId], references: [id], onDelete: Cascade)
  table  RestaurantTable @relation(fields: [tableId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([outletId, status])
  @@index([tableId, status])
  @@map("dining_sessions")
}

// =============================================================================
// Menu
// =============================================================================

model Menu {
  id        String   @id @default(uuid())
  outletId  String
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  outlet     Outlet         @relation(fields: [outletId], references: [id], onDelete: Cascade)
  categories MenuCategory[]

  @@index([outletId])
  @@map("menus")
}

model MenuCategory {
  id           String   @id @default(uuid())
  menuId       String
  name         String
  description  String?
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  menu  Menu       @relation(fields: [menuId], references: [id], onDelete: Cascade)
  items MenuItem[]

  @@index([menuId])
  @@map("menu_categories")
}

model MenuItem {
  id           String   @id @default(uuid())
  categoryId   String
  taxGroupId   String?
  name         String
  description  String?
  sku          String?
  imageUrl     String?
  basePrice    Decimal  @db.Decimal(12, 2)
  isVegetarian Boolean  @default(true)
  isAvailable  Boolean  @default(true)
  isActive     Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  category       MenuCategory            @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  taxGroup       TaxGroup?               @relation(fields: [taxGroupId], references: [id])
  variants       MenuItemVariant[]
  modifierGroups MenuItemModifierGroup[]
  orderItems     OrderItem[]

  @@index([categoryId])
  @@map("menu_items")
}

model MenuItemVariant {
  id            String   @id @default(uuid())
  menuItemId    String
  name          String
  priceOverride Decimal  @db.Decimal(12, 2)
  isDefault     Boolean  @default(false)
  displayOrder  Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  menuItem   MenuItem    @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@index([menuItemId])
  @@map("menu_item_variants")
}

model ModifierGroup {
  id           String   @id @default(uuid())
  outletId     String
  name         String
  minSelect    Int      @default(0)
  maxSelect    Int      @default(1)
  isRequired   Boolean  @default(false)
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  outlet    Outlet                  @relation(fields: [outletId], references: [id], onDelete: Cascade)
  modifiers Modifier[]
  menuItems MenuItemModifierGroup[]

  @@index([outletId])
  @@map("modifier_groups")
}

model Modifier {
  id              String   @id @default(uuid())
  modifierGroupId String
  name            String
  priceDelta      Decimal  @default(0) @db.Decimal(12, 2)
  isActive        Boolean  @default(true)
  displayOrder    Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  modifierGroup ModifierGroup       @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)
  orderItems    OrderItemModifier[]

  @@index([modifierGroupId])
  @@map("modifiers")
}

/// Join table so a modifier group (e.g. "Toppings") can be reused across many menu items.
model MenuItemModifierGroup {
  id              String @id @default(uuid())
  menuItemId      String
  modifierGroupId String
  displayOrder    Int    @default(0)

  menuItem      MenuItem      @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  modifierGroup ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, modifierGroupId])
  @@map("menu_item_modifier_groups")
}

// =============================================================================
// Tax
// =============================================================================

enum TaxType {
  CGST
  SGST
  IGST
  SERVICE_CHARGE
}

model TaxGroup {
  id        String   @id @default(uuid())
  outletId  String
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  outlet     Outlet             @relation(fields: [outletId], references: [id], onDelete: Cascade)
  components TaxGroupComponent[]
  menuItems  MenuItem[]

  @@index([outletId])
  @@map("tax_groups")
}

model TaxGroupComponent {
  id          String  @id @default(uuid())
  taxGroupId  String
  taxType     TaxType
  ratePercent Decimal @db.Decimal(5, 2)

  taxGroup TaxGroup @relation(fields: [taxGroupId], references: [id], onDelete: Cascade)

  @@index([taxGroupId])
  @@map("tax_group_components")
}

// =============================================================================
// Orders
// =============================================================================

enum OrderSource {
  POS
  WAITER
  QR
}

enum OrderType {
  DINE_IN
  TAKEAWAY
}

enum OrderStatus {
  DRAFT
  PLACED
  ACCEPTED
  PREPARING
  READY
  SERVED
  BILLED
  PAID
  COMPLETED
  CANCELLED
  REFUNDED
}

model Order {
  id              String      @id @default(uuid())
  organizationId  String
  outletId        String
  orderNumber     String
  source          OrderSource
  type            OrderType
  status          OrderStatus @default(DRAFT)
  tableId         String?
  diningSessionId String?
  guestToken      String?
  createdByUserId String?
  idempotencyKey  String?

  subtotal            Decimal @default(0) @db.Decimal(12, 2)
  discountTotal        Decimal @default(0) @db.Decimal(12, 2)
  taxTotal             Decimal @default(0) @db.Decimal(12, 2)
  serviceChargeTotal   Decimal @default(0) @db.Decimal(12, 2)
  roundOff             Decimal @default(0) @db.Decimal(12, 2)
  total                Decimal @default(0) @db.Decimal(12, 2)

  notes        String?
  placedAt     DateTime?
  cancelledAt  DateTime?
  cancelReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  outlet        Outlet         @relation(fields: [outletId], references: [id], onDelete: Cascade)
  table         RestaurantTable? @relation(fields: [tableId], references: [id])
  diningSession DiningSession? @relation(fields: [diningSessionId], references: [id])

  items              OrderItem[]
  events             OrderEvent[]
  discounts          DiscountApplication[]
  kitchenOrders      KitchenOrder[]
  invoice            Invoice?
  payments           Payment[]

  @@unique([outletId, orderNumber])
  @@unique([outletId, idempotencyKey])
  @@index([organizationId])
  @@index([outletId, status])
  @@index([diningSessionId])
  @@map("orders")
}

model OrderItem {
  id                String   @id @default(uuid())
  orderId           String
  menuItemId        String
  menuItemVariantId String?
  nameSnapshot       String
  variantNameSnapshot String?
  unitPrice          Decimal  @db.Decimal(12, 2)
  quantity            Int      @default(1)
  subtotal             Decimal  @db.Decimal(12, 2)
  discountAmount       Decimal  @default(0) @db.Decimal(12, 2)
  taxAmount            Decimal  @default(0) @db.Decimal(12, 2)
  total                Decimal  @db.Decimal(12, 2)
  notes               String?
  isCancelled          Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  order            Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem         MenuItem            @relation(fields: [menuItemId], references: [id])
  menuItemVariant  MenuItemVariant?    @relation(fields: [menuItemVariantId], references: [id])
  modifiers        OrderItemModifier[]
  kitchenItems     KitchenOrderItem[]
  invoiceItems     InvoiceItem[]

  @@index([orderId])
  @@map("order_items")
}

model OrderItemModifier {
  id                  String  @id @default(uuid())
  orderItemId         String
  modifierId          String
  nameSnapshot        String
  priceDeltaSnapshot  Decimal @db.Decimal(12, 2)
  quantity            Int     @default(1)

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  modifier  Modifier  @relation(fields: [modifierId], references: [id])

  @@index([orderItemId])
  @@map("order_item_modifiers")
}

enum OrderActorType {
  STAFF
  SYSTEM
  CUSTOMER
}

/// Append-only trail of every order state transition — drives auditability and
/// KDS "elapsed time"/history. See docs/architecture.md §5.
model OrderEvent {
  id           String          @id @default(uuid())
  orderId      String
  actorUserId  String?
  actorType    OrderActorType
  fromStatus   OrderStatus?
  toStatus     OrderStatus
  reason       String?
  metadata     Json?
  createdAt    DateTime        @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorUserId], references: [id])

  @@index([orderId])
  @@map("order_events")
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

model DiscountApplication {
  id             String       @id @default(uuid())
  orderId        String
  type           DiscountType
  value          Decimal      @db.Decimal(12, 2)
  amount         Decimal      @db.Decimal(12, 2)
  reason         String?
  appliedByUserId String
  createdAt      DateTime     @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("discount_applications")
}

// =============================================================================
// Kitchen (KOT / KDS)
// =============================================================================

model KitchenStation {
  id        String   @id @default(uuid())
  outletId  String
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  outlet        Outlet         @relation(fields: [outletId], references: [id], onDelete: Cascade)
  kitchenOrders KitchenOrder[]
  printers      Printer[]

  @@unique([outletId, name])
  @@index([outletId])
  @@map("kitchen_stations")
}

model KitchenOrder {
  id             String   @id @default(uuid())
  organizationId String
  outletId       String
  orderId        String
  stationId      String?
  kotNumber      String
  isModification Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  station KitchenStation? @relation(fields: [stationId], references: [id])
  items   KitchenOrderItem[]

  @@unique([outletId, kotNumber])
  @@index([orderId])
  @@index([stationId])
  @@map("kitchen_orders")
}

enum KitchenItemStatus {
  NEW
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

model KitchenOrderItem {
  id             String            @id @default(uuid())
  kitchenOrderId String
  orderItemId    String
  quantity       Int
  status         KitchenItemStatus @default(NEW)
  startedAt      DateTime?
  readyAt        DateTime?
  completedAt    DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  kitchenOrder KitchenOrder @relation(fields: [kitchenOrderId], references: [id], onDelete: Cascade)
  orderItem    OrderItem    @relation(fields: [orderItemId], references: [id])

  @@index([kitchenOrderId])
  @@map("kitchen_order_items")
}

// =============================================================================
// Billing
// =============================================================================

model Invoice {
  id                 String    @id @default(uuid())
  organizationId     String
  outletId           String
  orderId            String    @unique
  invoiceNumber      String
  subtotal           Decimal   @db.Decimal(12, 2)
  discountTotal      Decimal   @default(0) @db.Decimal(12, 2)
  taxTotal           Decimal   @default(0) @db.Decimal(12, 2)
  serviceChargeTotal Decimal   @default(0) @db.Decimal(12, 2)
  roundOff           Decimal   @default(0) @db.Decimal(12, 2)
  total              Decimal   @db.Decimal(12, 2)
  issuedAt           DateTime  @default(now())
  voidedAt           DateTime?
  createdAt          DateTime  @default(now())

  order Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  items InvoiceItem[]
  taxes InvoiceTax[]

  @@unique([outletId, invoiceNumber])
  @@index([organizationId])
  @@map("invoices")
}

model InvoiceItem {
  id          String  @id @default(uuid())
  invoiceId   String
  orderItemId String
  description String
  quantity    Int
  unitPrice   Decimal @db.Decimal(12, 2)
  subtotal    Decimal @db.Decimal(12, 2)
  taxAmount   Decimal @default(0) @db.Decimal(12, 2)
  total       Decimal @db.Decimal(12, 2)

  invoice   Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  orderItem OrderItem @relation(fields: [orderItemId], references: [id])

  @@index([invoiceId])
  @@map("invoice_items")
}

model InvoiceTax {
  id             String  @id @default(uuid())
  invoiceId      String
  taxType        TaxType
  ratePercent    Decimal @db.Decimal(5, 2)
  taxableAmount  Decimal @db.Decimal(12, 2)
  taxAmount      Decimal @db.Decimal(12, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_taxes")
}

// =============================================================================
// Payments
// =============================================================================

enum PaymentMethod {
  CASH
  UPI
  CARD
  OTHER
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

model Payment {
  id              String        @id @default(uuid())
  organizationId  String
  outletId        String
  orderId         String
  method          PaymentMethod
  status          PaymentStatus @default(PENDING)
  amount          Decimal       @db.Decimal(12, 2)
  currency        String        @default("INR")
  providerName    String?
  providerRef     String?
  initiatedByUserId String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  order        Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  transactions PaymentTransaction[]
  refunds      Refund[]

  @@index([organizationId])
  @@index([orderId])
  @@map("payments")
}

/// Raw log of every provider attempt/webhook event for a payment. `providerEventId` is
/// unique so a retried/duplicate webhook can never be double-applied (see docs/payments.md).
model PaymentTransaction {
  id              String   @id @default(uuid())
  paymentId       String
  provider        String
  providerEventId String
  type            String
  status          String
  rawPayload      Json?
  createdAt       DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@unique([provider, providerEventId])
  @@index([paymentId])
  @@map("payment_transactions")
}

enum RefundStatus {
  PENDING
  APPROVED
  PROCESSED
  REJECTED
}

model Refund {
  id               String       @id @default(uuid())
  paymentId        String
  amount           Decimal      @db.Decimal(12, 2)
  reason           String?
  status           RefundStatus @default(PENDING)
  initiatedByUserId String
  approvedByUserId  String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@map("refunds")
}

// =============================================================================
// Printing
// =============================================================================

enum PrinterType {
  KITCHEN
  RECEIPT
}

enum PrinterConnectionType {
  NETWORK
  USB
}

model Printer {
  id             String                 @id @default(uuid())
  outletId       String
  stationId      String?
  name           String
  type           PrinterType
  connectionType PrinterConnectionType  @default(NETWORK)
  ipAddress      String?
  port           Int?
  isActive       Boolean                @default(true)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  outlet  Outlet          @relation(fields: [outletId], references: [id], onDelete: Cascade)
  station KitchenStation? @relation(fields: [stationId], references: [id])
  jobs    PrinterJob[]

  @@index([outletId])
  @@map("printers")
}

enum PrinterJobStatus {
  QUEUED
  SENT
  FAILED
  ACKED
}

model PrinterJob {
  id        String            @id @default(uuid())
  printerId String
  payload   Json
  status    PrinterJobStatus  @default(QUEUED)
  attempts  Int               @default(0)
  lastError String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  printer Printer @relation(fields: [printerId], references: [id], onDelete: Cascade)

  @@index([printerId, status])
  @@map("printer_jobs")
}

// =============================================================================
// Audit
// =============================================================================

model AuditLog {
  id             String   @id @default(uuid())
  organizationId String
  outletId       String?
  actorUserId    String?
  action         String
  entityType     String
  entityId       String
  previousState  Json?
  newState       Json?
  deviceInfo     String?
  ipAddress      String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  outlet       Outlet?      @relation(fields: [outletId], references: [id])
  actor        User?        @relation(fields: [actorUserId], references: [id])

  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

// =============================================================================
// Supporting: daily counters for human-friendly sequential numbers
// (order numbers, KOT numbers, invoice numbers) without a global lock.
// =============================================================================

enum CounterType {
  ORDER
  KOT
  INVOICE
}

model OutletDailyCounter {
  id        String      @id @default(uuid())
  outletId  String
  type      CounterType
  date      DateTime    @db.Date
  lastValue Int         @default(0)

  outlet Outlet @relation(fields: [outletId], references: [id], onDelete: Cascade)

  @@unique([outletId, type, date])
  @@map("outlet_daily_counters")
}
