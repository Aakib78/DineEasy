# =============================================================================
# DineEasy — Environment Configuration
# Copy to .env and fill in real values. NEVER commit .env.
# =============================================================================

# --- General ---------------------------------------------------------------
NODE_ENV=development
APP_NAME=DineEasy
APP_VERSION=0.1.0
TZ=Asia/Kolkata
DEFAULT_LOCALE=en-IN
DEFAULT_CURRENCY=INR
DEFAULT_COUNTRY=IN

# --- API server --------------------------------------------------------------
API_PORT=3000
API_HOST=0.0.0.0
API_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:5173,http://localhost:3001

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=dineeasy
POSTGRES_USER=dineeasy
POSTGRES_PASSWORD=change_me_dev_only
DATABASE_URL=postgresql://dineeasy:change_me_dev_only@localhost:5432/dineeasy?schema=public

# --- Redis ---------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# --- Auth / JWT --------------------------------------------------------------
# Generate strong random secrets in real deployments, e.g. `openssl rand -hex 64`
JWT_ACCESS_SECRET=change_me_dev_access_secret_please_rotate
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change_me_dev_refresh_secret_please_rotate
JWT_REFRESH_TTL=30d
BCRYPT_SALT_ROUNDS=12

# --- QR tokens --------------------------------------------------------------
QR_TOKEN_SECRET=change_me_dev_qr_secret_please_rotate

# --- Payments (provider-independent abstraction; fill in when integrating) ---
PAYMENTS_PROVIDER=manual
PAYMENTS_WEBHOOK_SECRET=change_me_dev_webhook_secret

# --- Rate limiting --------------------------------------------------------------
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=120

# --- Local network / discovery ---------------------------------------------
MDNS_SERVICE_NAME=dineeasy
MDNS_SERVICE_TYPE=_dineeasy._tcp

# --- Logging --------------------------------------------------------------
LOG_LEVEL=info

# --- API docs ---------------------------------------------------------------
# Swagger UI + raw OpenAPI JSON at /api/docs and /api/docs-json (see main.ts). Unset = on
# outside production, off in production; set explicitly to override either way.
# API_DOCS_ENABLED=true
